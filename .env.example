# AI provider: "gemini", "groq", "openai", or "anthropic"
AI_PROVIDER=gemini

# Google Gemini (when AI_PROVIDER=gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
# Also accepts GOOGLE_API_KEY as an alias

# Groq (when AI_PROVIDER=groq)
GROQ_API_KEY=gsk-your-groq-key
GROQ_MODEL=llama-3.1-8b-instant

# OpenAI (when AI_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Anthropic (when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# No quotes around keys. Save .env.local then restart: npm run dev

# Supabase Cloud Sync (optional)
# Create a project at https://supabase.com, then copy these from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key